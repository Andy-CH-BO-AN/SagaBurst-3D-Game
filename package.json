{
  "name": "sagaburst",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "test": "vitest run",
    "preview": "vite preview",
    "build:web": "npm run build",
    "build:desktop": "tsc && vite build --mode desktop",
    "desktop": "npm run build:desktop && electron .",
    "package:desktop": "npm run build:desktop && electron-builder --publish never",
    "smoke:web": "node tools/release/smoke.mjs",
    "smoke:desktop": "node tools/release/smoke.mjs --desktop",
    "test:release": "node --test tools/release/*.test.cjs",
    "validate:release": "node tools/release/validate-tag.cjs",
    "typecheck:test": "node tools/typecheck-tests.cjs"
  },
  "dependencies": {
    "playwright": "^1.61.1",
    "three": "^0.167.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/three": "^0.167.0",
    "meshoptimizer": "^0.18.1",
    "typescript": "^5.5.3",
    "vite": "^5.3.4",
    "vitest": "^4.1.10",
    "electron": "44.5.1",
    "electron-builder": "26.15.3"
  },
  "description": "SagaBurst \u2014 Viking and Roman 3D battles",
  "author": "Andy-CH-BO-AN",
  "main": "electron/main.cjs",
  "build": {
    "appId": "com.sagaburst.game",
    "productName": "SagaBurst",
    "directories": {
      "output": "release"
    },
    "files": [
      "electron/**",
      "dist-desktop/**",
      "package.json"
    ],
    "mac": {
      "target": [
        {
          "target": "zip",
          "arch": [
            "arm64"
          ]
        }
      ],
      "identity": "-",
      "artifactName": "SagaBurst-v${version}-macOS-${arch}.${ext}",
      "hardenedRuntime": false,
      "extraDistFiles": [
        "MACOS-FIRST-LAUNCH.txt"
      ]
    },
    "win": {
      "target": [
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ],
      "signAndEditExecutable": false,
      "artifactName": "SagaBurst-v${version}-Windows-${arch}.${ext}"
    }
  }
}
