{
  "description": "Runtime GLB budget pass: texture caps, KTX2 (KHR_texture_basisu) encoding and UV-exact LOD reductions. Applied by tools/apply-runtime-glb-budget.mjs; results in runtime-glb-budget-audit.json.",
  "textures": {
    "defaultMaxSize": 2048,
    "rules": [
      {
        "match": "^models/weapons/",
        "maxSize": 1024
      }
    ],
    "encoding": {
      "color": [
        "-etc1s",
        "-quality",
        "90",
        "-effort",
        "5",
        "-mipmap"
      ],
      "linear": [
        "-uastc",
        "-uastc_level",
        "2",
        "-uastc_rdo_l",
        "1.0",
        "-linear",
        "-mipmap",
        "-ktx2_zstandard_level",
        "18"
      ],
      "normal": [
        "-uastc",
        "-uastc_level",
        "2",
        "-uastc_rdo_l",
        "0.5",
        "-normal_map",
        "-mipmap",
        "-ktx2_zstandard_level",
        "18"
      ]
    }
  },
  "skip": [
    "models/mounts/v1/horse/horse_runtime.glb",
    "models/mounts/v1/armored-horse/armored-horse.glb",
    "models/architecture/viking-berserker-statue.glb",
    "models/architecture/roman-byzantine-statue.glb",
    "models/mounts/v2/xongkoro/xongkoro.glb"
  ],
  "lod": [
    {
